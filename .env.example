# Host development database. Used by local npm/prisma commands.
DATABASE_URL="postgresql://openexam:openexam@localhost:5432/openexam?schema=public"

# Docker Compose database settings. Containers must use the `postgres` service
# hostname, while host commands should keep using `localhost`.
DOCKER_DATABASE_URL="postgresql://openexam:openexam@postgres:5432/openexam?schema=public"
POSTGRES_DB="openexam"
POSTGRES_USER="openexam"
POSTGRES_PASSWORD="openexam"
POSTGRES_PORT="5432"

# Auth
AUTH_SECRET="replace-with-a-random-secret"
AUTH_URL="http://localhost:3000"
SESSION_SECRET="replace-with-a-random-session-secret"
SESSION_DAYS="14"

# Initial admin account for Docker web startup and `npm run db:seed`.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-at-least-8-characters"
ADMIN_NAME="管理员"

# Storage
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR="./storage"
DOCKER_LOCAL_STORAGE_DIR="/app/storage"
S3_REGION="us-east-1"
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"
AWS_PROFILE=""

# Optional platform AI provider keys. Users may also bring their own keys.
AI_KEY_ENCRYPTION_SECRET="replace-with-a-random-ai-key-encryption-secret"
OPENAI_API_KEY=""
OPENAI_BASE_URL=""
OPENAI_API_MODE="chat"
OPENEXAM_DAILY_AI_CALL_LIMIT="50"
OPENEXAM_DAILY_PLATFORM_TOKEN_LIMIT="100000"
OPENEXAM_UPLOAD_MAX_BYTES="10485760"
OPENEXAM_MATERIAL_EXTRACT_CONTEXT_CHARS="1048576"
OPENEXAM_MATERIAL_EXTRACT_TIMEOUT_MS="1200000"
OPENEXAM_MATERIAL_EXTRACT_JOB_STALE_MS="1500000"
OPENEXAM_IMPORT_EXTERNAL_IMAGES="true"
OPENEXAM_WORKER_POLL_MS="3000"
OPENEXAM_JOB_STALE_MS="900000"
OPENEXAM_WORKER_HEALTH_PATH="/tmp/openexam-worker-health.json"
OPENEXAM_WORKER_HEALTH_MAX_AGE_MS="30000"
ANTHROPIC_API_KEY=""
ANTHROPIC_BASE_URL=""
GEMINI_API_KEY=""
GEMINI_BASE_URL=""

# Application
NEXT_PUBLIC_APP_NAME="OpenExam"

# The learner UI and admin console run in one web app; admin routes are under /admin.
NEXT_PUBLIC_WEB_URL="http://127.0.0.1:3000"
NEXT_PUBLIC_ADMIN_URL="http://127.0.0.1:3000/admin"
WEB_PORT="3000"
