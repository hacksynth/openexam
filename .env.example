# Database
DATABASE_URL="postgresql://openexam:openexam@localhost:5432/openexam?schema=public"

# Auth
AUTH_SECRET="replace-with-a-random-secret"
AUTH_URL="http://localhost:3000"
SESSION_SECRET="replace-with-a-random-session-secret"
SESSION_DAYS="14"

# Initial admin account for `npm run db:seed`.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-at-least-8-characters"
ADMIN_NAME="管理员"

# Storage
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR="./storage"
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Optional platform AI provider keys. Users may also bring their own keys.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# Application
NEXT_PUBLIC_APP_NAME="OpenExam"

# The learner and admin apps are deployed as separate containers.
NEXT_PUBLIC_WEB_URL="http://127.0.0.1:3000"
NEXT_PUBLIC_ADMIN_URL="http://127.0.0.1:3001"
